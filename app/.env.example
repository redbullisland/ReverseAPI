# Copy to .env.local (gitignored) and fill with your own values.
# Next.js inlines NEXT_PUBLIC_* into the browser JS bundle — use dev/throwaway
# values only. Anything pasted in the UI overrides these and is saved to localStorage.
NEXT_PUBLIC_EYECON_CLIENT_ID=
NEXT_PUBLIC_TRUECALLER_TOKEN=
# Optional: external CORS relay template. Blank = built-in same-origin rewrite.
# Cloudflare Worker: https://<worker>.workers.dev/?url={url}&{headers}
NEXT_PUBLIC_CORS_PROXY_TEMPLATE=
